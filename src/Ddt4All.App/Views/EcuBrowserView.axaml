<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ddt4All.App.ViewModels"
             xmlns:m="using:Ddt4All.App.Models"
             xmlns:v="using:Ddt4All.App.Views"
             xmlns:svc="using:Ddt4All.App.Services"
             xmlns:loc="using:Ddt4All.App.Localization"
             x:Class="Ddt4All.App.Views.EcuBrowserView"
             x:DataType="vm:EcuBrowserViewModel">
    <Grid ColumnDefinitions="*,Auto" Margin="28 24 28 20" ColumnSpacing="20">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding ResultSummary}" VerticalAlignment="Bottom" />
                <StackPanel Spacing="2">
                    <TextBlock Classes="h1" Text="{loc:Tr 'ECU Browser'}" />
                    <TextBlock Classes="muted" Text="{loc:Tr 'Search the ECU database by name, address, project or protocol.'}" />
                </StackPanel>
            </DockPanel>

            <!-- database warning -->
            <Border Grid.Row="1" Classes="card" Padding="12" IsVisible="{Binding DatabaseMissing}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding OpenSettingsCommand}" Content="{loc:Tr 'Settings'}" />
                    <TextBlock VerticalAlignment="Center" Text="{loc:Tr 'No database found'}" />
                </DockPanel>
            </Border>

            <!-- toolbar -->
            <Grid Grid.Row="2" ColumnDefinitions="1.6*,1.3*,1.4*,1.3*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding SearchText}" PlaceholderText="{loc:Tr 'Search ECUs...'}">
                    <TextBox.InnerLeftContent><PathIcon Data="{x:Static svc:Icons.Search}" Width="14" Height="14" Margin="10 0 0 0" Foreground="{DynamicResource TextMutedBrush}" /></TextBox.InnerLeftContent>
                </TextBox>
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ProjectFilters}" SelectedItem="{Binding SelectedProject}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding ProtocolFilters}" SelectedItem="{Binding SelectedProtocol}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" ItemsSource="{Binding GroupModes}" SelectedItem="{Binding SelectedGroupMode}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChoiceItem"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Command="{Binding ClearFiltersCommand}" Height="34" ToolTip.Tip="{loc:Tr 'Clear filters'}"><PathIcon Data="{x:Static svc:Icons.Close}" Width="12" Height="12" /></Button>
            </Grid>

            <!-- list -->
            <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Height="36" ColumnDefinitions="*,70,140,100" Background="{DynamicResource SurfaceAltBrush}">
                        <TextBlock Classes="caption" Text="{loc:Tr 'Name'}" VerticalAlignment="Center" Margin="16 0 0 0" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Classes="caption" Text="{loc:Tr 'Address'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Classes="caption" Text="{loc:Tr 'Protocol'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Classes="caption" Text="{loc:Tr 'Project'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="2" />
                    <v:EcuListBox Grid.Row="2" Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0" Padding="0">
                        <v:EcuListBox.DataTemplates>
                            <DataTemplate DataType="m:GroupHeaderRow">
                                <Grid Height="34" ColumnDefinitions="*,Auto" Margin="16 0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                    <Border Grid.Column="1" Classes="pill" Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding Count}" FontSize="11" Classes="muted" /></Border>
                                </Grid>
                            </DataTemplate>
                            <DataTemplate DataType="m:EcuEntry">
                                <Grid Height="34" ColumnDefinitions="*,70,140,100">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="16 0 8 0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Address}" Classes="mono" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Protocol}" Classes="muted" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Project}" Classes="muted mono" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </v:EcuListBox.DataTemplates>
                    </v:EcuListBox>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsEmpty}" IsHitTestVisible="False">
                        <PathIcon Data="{x:Static svc:Icons.Search}" Width="28" Height="28" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Classes="muted" Text="{loc:Tr 'No ECUs match your filters.'}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- details -->
        <Border Grid.Column="1" Classes="card" Width="300" VerticalAlignment="Stretch">
            <Grid>
                <StackPanel IsVisible="{Binding NoSelection}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <PathIcon Data="{x:Static svc:Icons.Ecu}" Width="34" Height="34" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Classes="muted" Text="{loc:Tr 'Select an ECU to see its details.'}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" />
                </StackPanel>
                <ScrollViewer IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="16" DataContext="{Binding SelectedEntry}" x:DataType="m:EcuEntry">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Name}" Classes="h1" FontSize="18" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProjectName}" Classes="muted" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
                            <TextBlock Classes="caption" Text="{loc:Tr 'Address'}" />
                            <TextBlock Grid.Column="1" Text="{Binding Address}" Classes="mono" />
                            <TextBlock Grid.Row="1" Classes="caption" Text="{loc:Tr 'Protocol'}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Protocol}" />
                            <TextBlock Grid.Row="2" Classes="caption" Text="{loc:Tr 'Project'}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Project}" Classes="mono" />
                            <TextBlock Grid.Row="3" Classes="caption" Text="{loc:Tr 'Supplier'}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Supplier}" />
                            <TextBlock Grid.Row="4" Classes="caption" Text="{loc:Tr 'Version'}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Version}" Classes="mono" />
                            <TextBlock Grid.Row="5" Classes="caption" Text="{loc:Tr 'Variants'}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VariantCount}" />
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="caption" Text="{loc:Tr 'File'}" />
                            <TextBlock Text="{Binding File}" Classes="mono" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="36"
                                Command="{Binding $parent[v:EcuBrowserView].Vm.OpenEcuCommand}" CommandParameter="{Binding}" Content="{loc:Tr 'Open ECU'}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
