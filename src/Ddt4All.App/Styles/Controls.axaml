<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- typography -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /><Setter Property="Margin" Value="0 0 0 4" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /></Style>
    <Style Selector="TextBox.mono"><Setter Property="FontFamily" Value="{DynamicResource MonoFont}" /></Style>

    <!-- surfaces -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8 2" />
    </Style>
    <Style Selector="Border.statuspill"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
    <Style Selector="Border.statuspill.active"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" /></Style>
    <Style Selector="Path.icon, PathIcon.icon"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></Style>

    <!-- inputs: slightly tighter and more modern than the Fluent defaults -->
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="34" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6" /><Setter Property="MinHeight" Value="34" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="6" /></Style>

    <Style Selector="Button:not(.accent):not(.danger):not(.ghost):not(.nav)">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button:not(.accent):not(.danger):not(.ghost):not(.nav):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8 6" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="0.45" /></Style>

    <!-- navigation rail buttons -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource NavHoverBrush}" /></Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource NavHoverBrush}" /></Style>
    <Style Selector="Button.nav.active TextBlock"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.nav Border.indicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Button.nav.active Border.indicator"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Button.nav PathIcon"><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style Selector="Button.nav.active PathIcon"><Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" /></Style>

    <!-- segmented control (ListBox) -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="Padding" Value="12 6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- virtualised data lists -->
    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.segmented ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>
    <Style Selector="ListBoxItem.group-header">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- toasts -->
    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12 10" />
        <Setter Property="Width" Value="340" />
        <Setter Property="Margin" Value="0 8 0 0" />
        <Setter Property="BoxShadow" Value="{DynamicResource ToastShadow}" />
    </Style>
</Styles>
